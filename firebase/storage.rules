rules_version = '2';

// Regras do Storage — Falaa Cidade.
// Como publicar: Console do Firebase > Storage > Regras > colar > Publicar.
//
// Fotos de cada ocorrência (nomes fixos e numerados):
//   ocorrencias/{idOcorrencia}/problema/1.jpg ... 5.jpg      (até 5, enviadas pelo notificante)
//   ocorrencias/{idOcorrencia}/referencia/1.jpg ... 2.jpg    (até 2, enviadas pelo notificante)
//   ocorrencias/{idOcorrencia}/resolvida/1.jpg ... 3.jpg     (até 3, enviadas pela prefeitura)
//   usuarios/{uid}/foto-perfil.jpg
// O app já comprime cada foto para no máximo 1 MB; aqui o limite é 2 MB, como margem.

service firebase.storage {
  match /b/{armazenamento}/o {

    function estaLogado() {
      return request.auth != null;
    }

    function ehImagemJpeg() {
      return request.resource.contentType == 'image/jpeg';
    }

    function temMenosDe(limiteEmMegabytes) {
      return request.resource.size < limiteEmMegabytes * 1024 * 1024;
    }

    // Lê a ocorrência no Firestore para saber o notificante, a situação e o órgão.
    // O documento precisa existir ANTES da foto (passo 1 do fluxo do app).
    function buscarOcorrencia(idOcorrencia) {
      return firestore.get(/databases/(default)/documents/ocorrencias/$(idOcorrencia)).data;
    }

    function ehONotificanteDaOcorrenciaAberta(idOcorrencia) {
      return buscarOcorrencia(idOcorrencia).idNotificante == request.auth.uid
        && buscarOcorrencia(idOcorrencia).situacao == 'aberta';
    }

    match /ocorrencias/{idOcorrencia}/problema/{arquivo} {
      allow read: if true;
      allow write: if estaLogado()
        && arquivo.matches('[1-5][.]jpg')
        && ehImagemJpeg() && temMenosDe(2)
        && ehONotificanteDaOcorrenciaAberta(idOcorrencia);
    }

    match /ocorrencias/{idOcorrencia}/referencia/{arquivo} {
      allow read: if true;
      allow write: if estaLogado()
        && arquivo.matches('[1-2][.]jpg')
        && ehImagemJpeg() && temMenosDe(2)
        && ehONotificanteDaOcorrenciaAberta(idOcorrencia);
    }

    match /ocorrencias/{idOcorrencia}/resolvida/{arquivo} {
      allow read: if true;
      allow write: if estaLogado()
        && arquivo.matches('[1-3][.]jpg')
        && ehImagemJpeg() && temMenosDe(2)
        && request.auth.token.papel == 'prefeitura'
        && request.auth.token.idCidade == buscarOcorrencia(idOcorrencia).idCidade
        && request.auth.token.idDepartamento == buscarOcorrencia(idOcorrencia).idDepartamento;
    }

    match /usuarios/{uid}/foto-perfil.jpg {
      allow read: if true;
      allow write: if estaLogado() && request.auth.uid == uid
        && ehImagemJpeg() && temMenosDe(2);
    }
  }
}

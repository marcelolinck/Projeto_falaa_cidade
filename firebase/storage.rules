rules_version = '2';

// Regras do Storage — Falaa Cidade.
// Como publicar: Console do Firebase > Storage > Regras > colar > Publicar.
//
// Fotos de cada ocorrência (nomes fixos, numerados):
//   ocorrencias/{id}/pothole/1.jpg ... 5.jpg    (problema, até 5, pelo autor)
//   ocorrencias/{id}/reference/1.jpg ... 2.jpg  (referência, até 2, pelo autor)
//   ocorrencias/{id}/resolved/1.jpg ... 3.jpg   (resolvido, até 3, pela prefeitura)
// O app já comprime cada foto para no máximo 1 MB; aqui o teto é 2 MB de margem.

service firebase.storage {
  match /b/{bucket}/o {

    function logado() {
      return request.auth != null;
    }

    function ehImagemJpeg() {
      return request.resource.contentType == 'image/jpeg';
    }

    function ate(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    // Lê a ocorrência no Firestore para saber o autor, o status e o órgão.
    // O documento precisa existir ANTES da foto (passo 1 do fluxo do app).
    function ocorrencia(ocorrenciaId) {
      return firestore.get(/databases/(default)/documents/ocorrencias/$(ocorrenciaId)).data;
    }

    match /ocorrencias/{ocorrenciaId}/pothole/{foto} {
      allow read: if true;
      allow write: if logado()
        && foto.matches('[1-5][.]jpg')
        && ehImagemJpeg() && ate(2)
        && ocorrencia(ocorrenciaId).reporterId == request.auth.uid
        && ocorrencia(ocorrenciaId).status == 'aberta';
    }

    match /ocorrencias/{ocorrenciaId}/reference/{foto} {
      allow read: if true;
      allow write: if logado()
        && foto.matches('[1-2][.]jpg')
        && ehImagemJpeg() && ate(2)
        && ocorrencia(ocorrenciaId).reporterId == request.auth.uid
        && ocorrencia(ocorrenciaId).status == 'aberta';
    }

    match /ocorrencias/{ocorrenciaId}/resolved/{foto} {
      allow read: if true;
      allow write: if logado()
        && foto.matches('[1-3][.]jpg')
        && ehImagemJpeg() && ate(2)
        && request.auth.token.role == 'city_official'
        && request.auth.token.cityId == ocorrencia(ocorrenciaId).cityId
        && request.auth.token.departmentId == ocorrencia(ocorrenciaId).departmentId;
    }

    match /usuarios/{uid}/avatar.jpg {
      allow read: if true;
      allow write: if logado() && request.auth.uid == uid
        && ehImagemJpeg() && ate(2);
    }
  }
}
